# Copy to .env and fill in. Real environment variables take precedence over this file.

# Bot token from https://discord.com/developers/applications (Bot tab).
DISCORD_TOKEN=

# SQLite file. Relative paths are relative to the working directory.
DATABASE_PATH=draftcup.db

# DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO

# Optional: a server ID where slash commands are synced instantly (useful while developing).
DEV_GUILD_ID=
